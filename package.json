{
  "name": "saujana-bgc-nuxt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "node -e \"require('fs').writeFileSync('public/version.json', JSON.stringify({v: Date.now()}))\" && nuxt generate && npm run verify:seo",
    "verify:seo": "tsx scripts/verify-seo.mts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "tsx --test tests/*.test.mts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.2",
    "dompurify": "3.4.18",
    "marked": "18.2.1",
    "nuxt": "4.6.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "supabase": "3.2.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
