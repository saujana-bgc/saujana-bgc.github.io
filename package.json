{
  "name": "saujana-bgc-nuxt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "node -e \"require('fs').writeFileSync('public/version.json', JSON.stringify({v: Date.now()}))\" && nuxt generate && npm run verify:seo",
    "verify:seo": "tsx scripts/verify-seo.mts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "tsx --test tests/*.test.mts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "nuxt": "4.6.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "supabase": "3.0.0",
    "tsx": "4.23.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
